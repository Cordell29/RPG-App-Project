# Copy to .env and keep it private (chmod 600). Read only by the server; never sent to browsers.

# ── AI keys ────────────────────────────────────────────────────────────────
# Claude (Anthropic console) runs the GM by default. Google AI Studio key: images, AI voice,
# and optionally the GM itself.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which AI runs the GM: auto (Claude if its key is set, else Gemini), anthropic, or gemini.
LLM_PROVIDER=auto
GM_TURN_MODEL=claude-sonnet-5-5
GM_SUMMARY_MODEL=claude-haiku-5-5
# Gemini GM (Interactions API) models, used when LLM_PROVIDER=gemini or only GEMINI_API_KEY is set.
# FREE Gemini key? Google's free tier covers only Flash models and has NO image generation.
# Use:  GEMINI_TEXT_MODEL=models/gemini-flash-latest  GEMINI_SUMMARY_MODEL=models/gemini-flash-lite-latest
#       IMAGES=off  GM_RULES_LOOKUP=off
GEMINI_TEXT_MODEL=models/gemini-4-argon
GEMINI_SUMMARY_MODEL=models/gemini-4-argon
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
# Let the GM look up 5e SRD / Starforged rules on the web (costs a little per search). on|off
GM_RULES_LOOKUP=on
# Portraits and scene pictures (Gemini, roughly 4-7 US cents each; not available on a free key). on|off
IMAGES=on

# ── Spending (estimates; also set hard limits in the Anthropic and Google billing consoles) ──
# Default daily cap for each new room (the host can change it in Backup & seats).
SPEND_CAP_ROOM_USD=5
# Daily cap across the whole server.
SPEND_CAP_GLOBAL_USD=20

# ── Public link ───────────────────────────────────────────────────────────
# With docker compose the Cloudflare Quick Tunnel link is found automatically.
# Set PUBLIC_URL only for a fixed address (own domain / named tunnel / Tailscale Funnel).
PUBLIC_URL=
# Optional: a Discord webhook URL that gets the new link whenever it changes.
SHARE_WEBHOOK_URL=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Rate limits (per IP and per player). Leave on; 'off' is for local testing only.
RATE_LIMITS=on
# Data lives in ./data (mounted at /data in Docker). Nightly backups go to data/backups,
# kept this many days. Copy them to a second disk or cloud folder if you can.
BACKUP_KEEP_DAYS=14
