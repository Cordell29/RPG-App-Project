# Copy to .env (chmod 600). Server-only; never exposed to the web bundle.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GM_TURN_MODEL=claude-sonnet-5-5
GM_SUMMARY_MODEL=claude-haiku-5-5
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
# Let the GM look up 5e SRD / Starforged rules with web search (costs a little per search). on|off
GM_RULES_LOOKUP=on
DATA_DIR=./data
PORT=3000
SHARE_WEBHOOK_URL=
# Nightly SQLite backups (one per day, kept this many days). Copy them to a second disk if you can.
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=14
